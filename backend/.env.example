# =============================================================================
# backend/.env.example — Modèle de configuration
# Copiez ce fichier en .env et remplissez vos vraies valeurs :
#   cp .env.example .env
#
# ⚠️  Ne commitez JAMAIS le fichier .env (il contient vos clés secrètes)
# =============================================================================

# --- Base de données PostgreSQL (Docker) ---
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/commercant_db

# --- Groq API (STT priorité 1 + NLU priorité 1) ---
# Gratuit, sans CB — Créer sur https://console.groq.com
GROQ_API_KEY=gsk_REMPLACER_PAR_VOTRE_CLE_GROQ

# --- Google Gemini API (NLU priorité 2) ---
# Gratuit — Créer sur https://aistudio.google.com/apikey
GOOGLE_API_KEY=AQ.REMPLACER_PAR_VOTRE_CLE_GEMINI

# --- OpenAI API (STT + NLU fallback, optionnel) ---
# Payant (crédits) — https://platform.openai.com/api-keys
# Laisser vide si vous utilisez uniquement Groq + Gemini
OPENAI_API_KEY=sk-REMPLACER_PAR_VOTRE_CLE_OPENAI

# --- Sécurité JWT ---
# Changez cette valeur en production (chaîne aléatoire longue)
SECRET_KEY=dev-secret-key-changez-moi-en-production

# --- Mode mock transcription (développement sans API) ---
# Décommentez pour activer : retourne une transcription fictive instantanément
# OPENAI_TRANSCRIPTION_MOCK=1
